# OpsPilot AI - API Service Environment Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database Connection (DATABASE_URL takes precedence if provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opspilot_db

# Alternative discrete Database parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=opspilot_db
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Service Graceful Shutdown Timeout (ms)
SHUTDOWN_TIMEOUT_MS=10000

# AI Business Copilot Settings
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=15000
