{
  "name": "opspilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "OpsPilot AI - Enterprise Operations Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@opspilot/api",
    "dev:web": "npm run dev --workspace=@opspilot/web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@opspilot/shared",
    "build:api": "npm run build --workspace=@opspilot/api",
    "build:web": "npm run build --workspace=@opspilot/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=@opspilot/api",
    "test:web": "npm run test --workspace=@opspilot/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "npm run db:migrate --workspace=@opspilot/api",
    "db:rollback": "npm run db:rollback --workspace=@opspilot/api",
    "db:status": "npm run db:status --workspace=@opspilot/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
